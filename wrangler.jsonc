// Configuração do Cloudflare Workers: publica a pasta public e o servidor do CRM (src/worker.js).
{
  "name": "caminhoperinatal",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Todos os pedidos passam pelo servidor, que verifica a sessão do Access antes de mostrar qualquer página.
    "run_worker_first": true
  },
  // Endereço próprio. O antigo caminhoperinatal.joacvr.workers.dev fica desligado: há uma só porta de entrada.
  "routes": [{ "pattern": "caminhoperinatal.com", "custom_domain": true }],
  "workers_dev": false,
  // Base de dados do CRM, criada no Cloudflare com a jurisdição UE (os dados ficam na União Europeia).
  "d1_databases": [
    { "binding": "DB", "database_name": "caminho-crm", "database_id": "d19323e2-3abe-42e3-9a70-02284cc33e6a" }
  ],
  // Todos os dias às 4h (UTC), atualiza clientes e encomendas da Shopify.
  "triggers": { "crons": ["17 4 * * *"] },
  "vars": {
    // Equipa do Cloudflare Access (Zero Trust → Settings → Custom Pages, ou o endereço do ecrã de entrada).
    "ACCESS_TEAM_DOMAIN": "young-wave-1a83.cloudflareaccess.com",
    // Application Audience (AUD) Tag da aplicação caminhoperinatal, em Zero Trust → Access → Applications.
    "ACCESS_AUD": "5237d8729c5dae6c8f46847efd5af0d445123d9d423d1ef00082fab2daf3c4f2",
    // Emails da equipa, separados por vírgulas. Vazio: vale só o que o Access deixar entrar.
    "EQUIPA_EMAILS": "",
    // Quem pode marcar «Não enviar ações comerciais» e importar a coluna em_consulta da folha antiga.
    "RESPONSAVEL_EMAIL": "joacvr@gmail.com",
    "SHOPIFY_LOJA": "palavraseoutrascoisas.myshopify.com",
    "SHOPIFY_API_VERSAO": "2026-07"
    // SHOPIFY_CLIENT_ID e SHOPIFY_CLIENT_SECRET são segredos: guardam-se em Settings → Variables and Secrets, nunca aqui.
  }
}
